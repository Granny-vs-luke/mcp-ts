{
  "name": "@mcp-ts/codemode",
  "version": "0.1.0",
  "description": "Sandboxed code-mode execution for MCP and agent tools using isolated-vm.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "npm --prefix ../toolrouter run build && npm run build && node --test test/*.test.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@mcp-ts/toolrouter": "file:../toolrouter",
    "isolated-vm": "^5.0.4"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
