{
  "name": "@mcp-ts/mcp-server-docs",
  "version": "1.0.0",
  "description": "MCP server for mcp-ts documentation",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mcp-server-docs": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm --clean --minify --platform node",
    "postbuild": "node -e \"const fs=require('fs'); if(fs.existsSync('../../docs')) fs.cpSync('../../docs', './dist/docs', {recursive: true})\"",
    "start": "node dist/index.js",
    "dev": "tsup src/index.ts src/server.ts --format esm --watch --onSuccess \"node dist/index.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fuse.js": "^7.1.0",
    "glob": "^11.0.1",
    "gray-matter": "^4.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vercel/node": "^3.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2"
  }
}
